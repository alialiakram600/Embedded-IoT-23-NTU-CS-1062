#include <iostream>
using namespace std;

void firstFit(int block[], int n, int process) {
    for (int i = 0; i < n; i++) {
        if (block[i] >= process) {
            cout << "\nFirst Fit Allocation:";
            cout << "\nProcess allocated in Block " << i + 1;
            cout << "\nRemaining Memory: " << block[i] - process << " KB\n";
            return;
        }
    }
    cout << "\nFirst Fit: Process not allocated\n";
}

void bestFit(int block[], int n, int process) {
    int best = -1;
    for (int i = 0; i < n; i++) {
        if (block[i] >= process) {
            if (best == -1 || block[i] < block[best])
                best = i;
        }
    }

    if (best != -1) {
        cout << "\nBest Fit Allocation:";
        cout << "\nProcess allocated in Block " << best + 1;
        cout << "\nRemaining Memory: " << block[best] - process << " KB\n";
    } else {
        cout << "\nBest Fit: Process not allocated\n";
    }
}

void worstFit(int block[], int n, int process) {
    int worst = -1;
    for (int i = 0; i < n; i++) {
        if (block[i] >= process) {
            if (worst == -1 || block[i] > block[worst])
                worst = i;
        }
    }

    if (worst != -1) {
        cout << "\nWorst Fit Allocation:";
        cout << "\nProcess allocated in Block " << worst + 1;
        cout << "\nRemaining Memory: " << block[worst] - process << " KB\n";
    } else {
        cout << "\nWorst Fit: Process not allocated\n";
    }
}

int main() {
    int n, process, choice;

    cout << "Enter number of memory blocks: ";
    cin >> n;

    int block[n];
    cout << "Enter size of each block (in KB):\n";
    for (int i = 0; i < n; i++) {
        cin >> block[i];
    }

    cout << "Enter process size (in KB): ";
    cin >> process;

    cout << "\nChoose Allocation Method:";
    cout << "\n1. First Fit";
    cout << "\n2. Best Fit";
    cout << "\n3. Worst Fit";
    cout << "\nEnter your choice: ";
    cin >> choice;

    switch (choice) {
        case 1:
            firstFit(block, n, process);
            break;
        case 2:
            bestFit(block, n, process);
            break;
        case 3:
            worstFit(block, n, process);
            break;
        default:
            cout << "\nInvalid choice!";
    }

    return 0;
}
